import os
import re
import cv2
import numpy as np

# --- CONFIGURATION ---
IMAGE_FOLDER = r"C:\Users\vivia\Downloads\JSRT images with nodules (154 images)\Radiology"  
TXT_FILE_PATH = r"C:\Users\vivia\Downloads\Clinical_Information\Clinical_Information\CLNDAT_EN.txt"         
OUTPUT_FOLDER = "images_with_white_circlesout"   # Folder where circled images will be saved
IMAGE_NAME = '_circleout.png'
# JSRT Standard Specifications
PIXEL_SPACING_MM = 0.175
RADIUS_BUFFER_PX = 0  # Additional pixels to add to the radius
RING_DISTANCE_PX = 57  # Distance in pixels from the inner circle to the outer circle (the ring region)

os.makedirs(OUTPUT_FOLDER, exist_ok=True)

# 1. Parse the JSRT coordinates text file using Regex 
with open(TXT_FILE_PATH, 'r', encoding='utf-8', errors='ignore') as f:
    content = f.read()

pattern = r'(JPCLN\d{3}\.IMG)'
parts = re.split(pattern, content)
records = []

for i in range(1, len(parts), 2):
    img_name_img_ext = parts[i]  # This is the original 'JPCLNxxx.IMG' filename 
    data_str = parts[i+1].strip()
    tokens = data_str.split()
    
    if len(tokens) >= 6:
        try:
            diameter_mm = float(tokens[1])  # Nodule max diameter in mm 
            cx = int(tokens[4])             # X coordinate center 
            cy = int(tokens[5])             # Y coordinate center 
            
            # Convert mm diameter to pixel radius
            radius_px = int((diameter_mm / 2) / PIXEL_SPACING_MM) + RADIUS_BUFFER_PX
            
            # Map the database record to your actual .png file extension
            png_name = img_name_img_ext.replace('.IMG', '.png')
            
            records.append({'name': png_name, 'cx': cx, 'cy': cy, 'r': radius_px})
        except ValueError:
            continue

print(f"Parsed {len(records)} records. Drawing white circles on PNG images...")
print(f"DEBUG: First 3 record names: {[r['name'] for r in records[:3]]}")

# Debug: Check the folder
print(f"DEBUG: Looking in folder: {IMAGE_FOLDER}")
print(f"DEBUG: Folder exists: {os.path.exists(IMAGE_FOLDER)}")
if os.path.exists(IMAGE_FOLDER):
    files = os.listdir(IMAGE_FOLDER)
    print(f"DEBUG: Found {len(files)} files. First 5: {files[:5]}")

# 2. Process PNG images and overlay white circles
processed_count = 0
for idx, record in enumerate(records):
    img_path = os.path.join(IMAGE_FOLDER, record['name'])
    
    # Debug: Show first few attempts
    if idx < 3:
        print(f"DEBUG: Looking for: {record['name']}")
        print(f"DEBUG: Full path: {img_path}")
        print(f"DEBUG: Exists: {os.path.exists(img_path)}")
    
    # Check if the PNG file actually exists in your folder
    if not os.path.exists(img_path):
        if processed_count < 3:  # Debug first few
            print(f"DEBUG: Not found: {record['name']}")
        continue
        
    # Read the PNG image natively in grayscale (keeps original brightness) 
    img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)
        
    if img is None:
        print(f"Failed to read image: {record['name']}")
        continue

    # Create a copy so we don't overwrite the original data in memory
    img_viewable = img.copy()
    
    # 3. Draw the two circles representing the ring region
    # Inner circle (the nodule itself)
    cv2.circle(img_viewable, (record['cx'], record['cy']), record['r'], 255, -1)
    
    # Outer circle (inner circle + ring distance)
    outer_radius = record['r'] + RING_DISTANCE_PX
    cv2.circle(img_viewable, (record['cx'], record['cy']), outer_radius, 255, 2)
    
    # Optional: Draw a tiny white dot at the center pixel 
    #cv2.circle(img_viewable, (record['cx'], record['cy']), 3, 255, -1)
    
    # 4. Save the final circled image 
    output_filename = record['name'].replace('.png', IMAGE_NAME)
    output_path = os.path.join(OUTPUT_FOLDER, output_filename)
    cv2.imwrite(output_path, img_viewable)
    processed_count += 1

print(f"\nDone! Processed {processed_count} images. Look inside the '{OUTPUT_FOLDER}' folder to see the white circles on your X-rays.")